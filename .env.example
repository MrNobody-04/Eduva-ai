# ==============================================================================
# EDUVA AI — ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to `.env` and supply your actual credentials.
# NEVER commit your real `.env` file to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION & SECURITY
# ------------------------------------------------------------------------------
ENVIRONMENT=development
ADMIN_API_KEY=your_high_entropy_admin_api_key_here
SESSION_SECRET=your_high_entropy_session_secret_salt_here
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://eduva-ai.vercel.app

# ------------------------------------------------------------------------------
# 2. AI PROVIDER 1: GOOGLE GEMINI (google-genai SDK)
# Supports multi-key pool for round-robin rotation, cooldowns, and failure isolation
# ------------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_API_KEY_1=your_optional_second_gemini_key_here
GEMINI_API_KEY_2=your_optional_third_gemini_key_here
GEMINI_MODEL=gemini-2.5-flash

# ------------------------------------------------------------------------------
# 3. AI PROVIDER 2: GROQ CLOUD
# Ultra-low latency inference, chat, and rapid classification
# ------------------------------------------------------------------------------
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.8-27b

# ------------------------------------------------------------------------------
# 4. AI PROVIDER 3: OPENROUTER
# Model diversity, secondary reasoning, and fallback routing
# ------------------------------------------------------------------------------
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct

# ------------------------------------------------------------------------------
# 5. AI PROVIDER 4: CLOUDFLARE WORKERS AI
# Fast edge verification, fact-checking, and high-throughput inference
# ------------------------------------------------------------------------------
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id_here
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token_here
CLOUDFLARE_MODEL=@cf/meta/llama-3.1-8b-instruct

# ------------------------------------------------------------------------------
# 6. CONCURRENCY & QUOTA PROTECTION
# ------------------------------------------------------------------------------
AI_MAX_GLOBAL_CONCURRENCY=20
AI_QUOTA_RESERVE_PERCENT=20
GEMINI_MAX_CONCURRENCY=5
GROQ_MAX_CONCURRENCY=10
OPENROUTER_MAX_CONCURRENCY=3
CLOUDFLARE_MAX_CONCURRENCY=5
