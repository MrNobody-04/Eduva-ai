# ==============================================================================
# EDUVA AI — ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to `.env` and supply your actual credentials.
# NEVER commit your real `.env` file to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION & SECURITY
# ------------------------------------------------------------------------------
ENVIRONMENT=development
ADMIN_API_KEY=your_high_entropy_admin_api_key_here
SESSION_SECRET=your_high_entropy_session_secret_salt_here
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://eduva-ai.vercel.app

# ------------------------------------------------------------------------------
# 2. AI PROVIDER 1: GOOGLE GEMINI (google-genai SDK)
# Supports multi-key pool for round-robin rotation, cooldowns, and failure isolation
# ------------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_API_KEY_1=your_optional_second_gemini_key_here
GEMINI_API_KEY_2=your_optional_third_gemini_key_here
GEMINI_MODEL=gemini-2.5-flash

# ------------------------------------------------------------------------------
# 3. AI PROVIDER 2: CEREBRAS CLOUD
# ------------------------------------------------------------------------------
CEREBRAS_API_KEY=your_cerebras_api_key_here
CEREBRAS_MODEL=llama3.1-8b

# ------------------------------------------------------------------------------
# 4. AI PROVIDER 3: GROQ CLOUD
# ------------------------------------------------------------------------------
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.8-27b

# ------------------------------------------------------------------------------
# 5. AI PROVIDER 4: OPENROUTER
# ------------------------------------------------------------------------------
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct

# ------------------------------------------------------------------------------
# 6. AI PROVIDER 5: OLLAMA (Local or Remote Private Daemon)
# ------------------------------------------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# ------------------------------------------------------------------------------
# 7. CONCURRENCY & QUOTA PROTECTION
# ------------------------------------------------------------------------------
GLOBAL_MAX_CONCURRENCY=20
AI_QUOTA_RESERVE_PERCENT=20
