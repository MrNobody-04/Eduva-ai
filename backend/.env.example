# EDUVA AI - Environment Configuration Template
DATABASE_URL=postgresql://postgres.<project_id>:<password>@aws-0-ap-south-1.pooler.supabase.com:5432/postgres
SUPABASE_HOST=aws-0-ap-south-1.pooler.supabase.com
SUPABASE_PORT=5432
SUPABASE_USER=postgres.<project_id>
SUPABASE_DB=postgres
SUPABASE_REGION=ap-south-1
ENVIRONMENT=production

# Google Gemini API Keys (Modern google-genai SDK, Multi-Key Pool)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_API_KEY_1=your_primary_gemini_api_key_here
GEMINI_API_KEY_2=your_secondary_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Security Secrets & Authentication (Required in Production)
ADMIN_API_KEY=generate_a_64_character_hex_secret_here
SESSION_SECRET=generate_a_64_character_hex_secret_here
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,https://eduva-ai.vercel.app

# Multi-Provider AI Keys & Endpoints (4 Active Providers)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.8-27b

OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct

CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id_here
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token_here
CLOUDFLARE_MODEL=@cf/meta/llama-3.1-8b-instruct

# AI Gateway Concurrency & Quota Protection Limits
AI_MAX_GLOBAL_CONCURRENCY=20
AI_QUOTA_RESERVE_PERCENT=20
GEMINI_MAX_CONCURRENCY=5
GROQ_MAX_CONCURRENCY=10
OPENROUTER_MAX_CONCURRENCY=3
CLOUDFLARE_MAX_CONCURRENCY=5
